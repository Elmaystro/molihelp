# ── Telegram ──────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your supergroup ID (negative number, starts with -100)
# To find it: add @raw_data_bot to your group and send any message
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ── GitHub (only needed for the local bot, not for CI) ───
# Personal Access Token with  repo  +  actions:write  scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# owner/repo
GITHUB_REPO=your-username/molihelp

# ── Optional defaults ────────────────────────────────────
# WORKFLOW_FILE=ad-scraper.yml
# DEFAULT_QUERY=running shoes
# DEFAULT_COUNTRY=ALL
